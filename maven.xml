<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>
    
    <groupId>com.example</groupId>
    <artifactId>instrument-aggregation-service</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>Instrument Aggregation Service</name>
    <description>Kafka-based instrument aggregation and persistence service</description>
    
    <properties>
        <java.version>11</java.version>
        <spring-kafka.version>2.8.11</spring-kafka.version>
        <micrometer.version>1.9.17</micrometer.version>
    </properties>
    
    <dependencies>
        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        
        <!-- Spring Kafka -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        
        <!-- Oracle JDBC Driver -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc8</artifactId>
            <version>21.9.0.0</version>
        </dependency>
        
        <!-- HikariCP (Connection Pool) -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        
        <!-- Micrometer & Prometheus -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        
        <!-- Jackson for JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        
        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        
        <!-- =============================================== -->
        <!-- CUSTOM EXTERNAL DEPENDENCIES FROM VENDOR       -->
        <!-- =============================================== -->
        
        <!-- 
            Custom Equity Message Model & Transformer
            Provided by upstream system vendor
            Both Equity and EquityTL topics receive EquityMessage
        -->
        <dependency>
            <groupId>com.vendor.instruments</groupId>
            <artifactId>equity-message-model</artifactId>
            <version>1.0.0</version>
            <!-- 
                Install manually using:
                mvn install:install-file -Dfile=equity-message-model-1.0.0.jar \
                    -DgroupId=com.vendor.instruments \
                    -DartifactId=equity-message-model \
                    -Dversion=1.0.0 -Dpackaging=jar
            -->
        </dependency>
        
        <dependency>
            <groupId>com.vendor.instruments</groupId>
            <artifactId>equity-transformer</artifactId>
            <version>1.0.0</version>
            <!-- 
                Contains: com.vendor.instruments.equity.EquityMessageTransformer
                Method: EquityMessage transformFromXml(String xmlContent)
            -->
        </dependency>
        
        <!-- 
            Custom Bond Message Model & Transformer
            Both Bond and BondTL topics receive BondMessage
        -->
        <dependency>
            <groupId>com.vendor.instruments</groupId>
            <artifactId>bond-message-model</artifactId>
            <version>1.0.0</version>
        </dependency>
        
        <dependency>
            <groupId>com.vendor.instruments</groupId>
            <artifactId>bond-transformer</artifactId>
            <version>1.0.0</version>
            <!-- 
                Contains: com.vendor.instruments.bond.BondMessageTransformer
                Method: BondMessage transformFromXml(String xmlContent)
            -->
        </dependency>
        
        <!-- 
            Custom Structured Product Message Model & Transformer
        -->
        <dependency>
            <groupId>com.vendor.instruments</groupId>
            <artifactId>structured-product-message-model</artifactId>
            <version>1.0.0</version>
        </dependency>
        
        <dependency>
            <groupId>com.vendor.instruments</groupId>
            <artifactId>structured-product-transformer</artifactId>
            <version>1.0.0</version>
            <!-- 
                Contains: com.vendor.instruments.structuredproduct.StructuredProductMessageTransformer
                Method: StructuredProductMessage transformFromXml(String xmlContent)
            -->
        </dependency>
        
        <!-- 
            Custom Warrant Message Model & Transformer
        -->
        <dependency>
            <groupId>com.vendor.instruments</groupId>
            <artifactId>warrant-message-model</artifactId>
            <version>1.0.0</version>
        </dependency>
        
        <dependency>
            <groupId>com.vendor.instruments</groupId>
            <artifactId>warrant-transformer</artifactId>
            <version>1.0.0</version>
            <!-- 
                Contains: com.vendor.instruments.warrant.WarrantMessageTransformer
                Method: WarrantMessage transformFromXml(String xmlContent)
            -->
        </dependency>
        
        <!-- Test Dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
